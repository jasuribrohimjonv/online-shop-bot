# @BotFather dan olingan bot tokeni
BOT_TOKEN=your_bot_token_here

# Admin foydalanuvchilar Telegram ID lari, vergul bilan ajratilgan
ADMIN_IDS=123456789,987654321

# PostgreSQL uchun (Docker Compose bilan ishlatish uchun standart qiymat)
DATABASE_URL=postgresql+asyncpg://shop:shop@db:5432/shop

# Lokal test uchun SQLite ishlatmoqchi bo'lsangiz, yuqoridagi qatorni o'chirib, quyidagini oching:
# DATABASE_URL=sqlite+aiosqlite:///shop.db
